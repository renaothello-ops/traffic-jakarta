# Copy to .env and fill with values from Firebase Console → Project settings → Your apps
# Do NOT use placeholder values like "xxxx" — authDomain must be a real hostname
# such as your-project-id.firebaseapp.com

VITE_FIREBASE_API_KEY=
# Must be project-id.firebaseapp.com — no https:// prefix
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public site URL for canonical, Open Graph, robots.txt, sitemap (no trailing slash).
# Default if unset: https://<VITE_FIREBASE_PROJECT_ID>.web.app
# VITE_PUBLIC_SITE_URL=https://traffic-jakarta.web.app

# App Check (optional)
VITE_FIREBASE_APP_CHECK_ENABLED=false
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Server-side only — .env.local, NOT VITE_ prefix
TOMTOM_API_KEY=

# Optional — server-side LLM for /api/analyze-report (not required; app uses rule-based fallback)
# OPENAI_API_KEY=

# Google Places API (New) — server-side only; also set in Vercel Environment Variables for production
GOOGLE_PLACES_API_KEY=

# Optional MapLibre basemap style URL (client-side). Default: OpenFreeMap Liberty (no key).
# Examples:
#   VITE_BASE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
#   VITE_BASE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY
# VITE_BASE_MAP_STYLE_URL=
